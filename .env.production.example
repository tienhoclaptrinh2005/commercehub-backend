# Documentation template only. Put real values in the deployment secret store,
# not in a committed .env.production file.

# Runtime and production database
SERVER_PORT=8080
DB_URL=jdbc:postgresql://YOUR_DB_HOST:5432/commercehub
DB_USERNAME=replace-with-production-database-user
DB_PASSWORD=replace-with-production-database-password
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Authentication
GOOGLE_CLIENT_ID=replace-with-production-google-client-id
JWT_SECRET=replace-with-a-random-production-base64-secret-of-at-least-32-bytes
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
AUTH_REFRESH_COOKIE_NAME=commercehub_refresh
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Strict
AUTH_REFRESH_COOKIE_MAX_AGE=604800

# Disable public API documentation unless it is intentionally protected.
SPRINGDOC_ENABLED=false

# SePay production
SEPAY_ENVIRONMENT=production
SEPAY_WEBHOOK_SECRET=replace-with-sepay-production-webhook-secret
SEPAY_BANK_CODE=replace-with-production-bank-code
SEPAY_BANK_ACCOUNT_NUMBER=replace-with-production-bank-account-number
SEPAY_ACCOUNT_NAME=replace-with-production-account-name
SEPAY_QR_BASE_URL=https://vietqr.app/img
SEPAY_DEPOSIT_TTL_MINUTES=15
SEPAY_DEPOSIT_EXPIRY_SCAN_MS=60000
SEPAY_CREATE_COOLDOWN_SECONDS=10
SEPAY_MAX_CREATES_PER_15_MINUTES=5
SEPAY_MAX_CREATES_PER_DAY=20

# Public application origin and jobs
CORS_ALLOWED_ORIGINS=https://tienhoclaptrinh.site,https://www.tienhoclaptrinh.site
JOB_BATCH_SIZE=200
DISPUTE_SELLER_RESPONSE_HOURS=24
DISPUTE_WARRANTY_PROCESSING_HOURS=24
DISPUTE_BUYER_CONFIRMATION_HOURS=24
DISPUTE_ADMIN_REVIEW_HOURS=72

# Cloudflare R2 production bucket
R2_ENABLED=true
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-production-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-production-secret-access-key
R2_BUCKET=commercehub-prod
MEDIA_PUBLIC_BASE_URL=https://images.tienhoclaptrinh.site
R2_PRESIGN_DURATION_SECONDS=300
R2_MAX_IMAGE_SIZE_BYTES=2097152
R2_PRODUCT_IMAGE_WIDTH=1200
R2_PRODUCT_IMAGE_HEIGHT=900
R2_AVATAR_MAX_IMAGE_SIZE_BYTES=1048576
R2_AVATAR_IMAGE_WIDTH=512
R2_AVATAR_IMAGE_HEIGHT=512
R2_IMAGE_CACHE_CONTROL=public, max-age=31536000, immutable
R2_UPLOAD_COOLDOWN_SECONDS=3
R2_MAX_PRESIGNS_PER_15_MINUTES=20
R2_RATE_LIMIT_STORE=redis
R2_RATE_LIMIT_KEY_PREFIX=commercehub:r2:presign
REDIS_URL=rediss://default:replace-with-redis-password@replace-with-redis-host:6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
