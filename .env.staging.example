# Documentation template only. Configure real values in the deployment platform
# or in /etc/commercehub/staging/backend.env with permission 0600. Never commit secrets.

SERVER_PORT=8080

# Docker Compose service hostname, not localhost.
DB_URL=jdbc:postgresql://postgres:5432/commercehub_staging
DB_USERNAME=commercehub_staging
DB_PASSWORD=replace-with-staging-database-password
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

GOOGLE_CLIENT_ID=replace-with-staging-google-client-id
JWT_SECRET=replace-with-a-random-staging-base64-secret-of-at-least-32-bytes
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
AUTH_REFRESH_COOKIE_NAME=commercehub_staging_refresh
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Strict
AUTH_REFRESH_COOKIE_MAX_AGE=604800

SPRINGDOC_ENABLED=false
CORS_ALLOWED_ORIGINS=https://staging.tienhoclaptrinh.site

JOB_BATCH_SIZE=200
ORDER_EXPIRY_CRON=0 * * * * *
DISPUTE_SELLER_RESPONSE_HOURS=24
DISPUTE_WARRANTY_PROCESSING_HOURS=24
DISPUTE_BUYER_CONFIRMATION_HOURS=24
DISPUTE_ADMIN_REVIEW_HOURS=72

SEPAY_ENVIRONMENT=test
SEPAY_WEBHOOK_SECRET=replace-with-staging-sepay-webhook-secret
SEPAY_BANK_CODE=replace-with-staging-bank-code
SEPAY_BANK_ACCOUNT_NUMBER=replace-with-staging-bank-account-number
SEPAY_ACCOUNT_NAME=replace-with-staging-account-name
SEPAY_QR_BASE_URL=https://vietqr.app/img
SEPAY_DEPOSIT_TTL_MINUTES=15
SEPAY_DEPOSIT_EXPIRY_SCAN_MS=60000
SEPAY_CREATE_COOLDOWN_SECONDS=10
SEPAY_MAX_CREATES_PER_15_MINUTES=5
SEPAY_MAX_CREATES_PER_DAY=20

R2_ENABLED=true
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-staging-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-staging-r2-secret-access-key
R2_BUCKET=commercehub-staging
MEDIA_PUBLIC_BASE_URL=https://images-staging.tienhoclaptrinh.site
R2_PRESIGN_DURATION_SECONDS=300
R2_MAX_IMAGE_SIZE_BYTES=2097152
R2_PRODUCT_IMAGE_WIDTH=1200
R2_PRODUCT_IMAGE_HEIGHT=900
R2_AVATAR_MAX_IMAGE_SIZE_BYTES=1048576
R2_AVATAR_IMAGE_WIDTH=512
R2_AVATAR_IMAGE_HEIGHT=512
R2_IMAGE_CACHE_CONTROL=public, max-age=31536000, immutable
R2_UPLOAD_COOLDOWN_SECONDS=3
R2_MAX_PRESIGNS_PER_15_MINUTES=20
R2_RATE_LIMIT_STORE=redis
R2_RATE_LIMIT_KEY_PREFIX=commercehub:staging:r2:presign

REDIS_URL=redis://redis:6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
CACHE_TYPE=redis
CACHE_KEY_PREFIX=commercehub:staging:cache
CACHE_DEFAULT_TTL=60s
CACHE_ACTIVE_CATEGORIES_TTL=15m
CACHE_BEST_SELLING_PRODUCTS_TTL=60s
CACHE_PUBLIC_PRODUCT_PAGES_TTL=60s
CACHE_PUBLIC_SHOPS_TTL=2m

CHAT_REDIS_PUBSUB_ENABLED=true
CHAT_REDIS_CHANNEL=commercehub:staging:chat:events
CHAT_RATE_LIMIT_KEY_PREFIX=commercehub:staging:chat:rate-limit
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_MAX_MESSAGES_PER_WINDOW=20
CHAT_RATE_LIMIT_WINDOW=10s

LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_HIBERNATE_SQL=WARN
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=WARN
