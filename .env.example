# Copy this file to .env for local development only. Never commit .env.

# Runtime and database
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5678/commercehub_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-database-password
FLYWAY_ENABLED=true
# Existing local DB only: true creates the V1 baseline once. Empty DB ignores this flag.
FLYWAY_BASELINE_ON_MIGRATE=true
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Authentication
GOOGLE_CLIENT_ID=replace-with-google-client-id
JWT_SECRET=replace-with-a-random-base64-secret-of-at-least-32-bytes
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
AUTH_REFRESH_COOKIE_NAME=commercehub_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict
AUTH_REFRESH_COOKIE_MAX_AGE=604800

# API documentation
SPRINGDOC_ENABLED=true

# SePay development/test mode
SEPAY_ENVIRONMENT=test
SEPAY_WEBHOOK_SECRET=replace-with-sepay-test-webhook-secret
SEPAY_BANK_CODE=replace-with-bank-code
SEPAY_BANK_ACCOUNT_NUMBER=replace-with-bank-account-number
SEPAY_ACCOUNT_NAME=replace-with-account-name
SEPAY_QR_BASE_URL=https://vietqr.app/img
SEPAY_DEPOSIT_TTL_MINUTES=15
SEPAY_DEPOSIT_EXPIRY_SCAN_MS=60000
SEPAY_CREATE_COOLDOWN_SECONDS=10
SEPAY_MAX_CREATES_PER_15_MINUTES=5
SEPAY_MAX_CREATES_PER_DAY=20

# Browser/backend CORS and scheduled jobs
CORS_ALLOWED_ORIGINS=http://localhost:3000
JOB_BATCH_SIZE=200
DISPUTE_SELLER_RESPONSE_HOURS=24
DISPUTE_WARRANTY_PROCESSING_HOURS=24
DISPUTE_BUYER_CONFIRMATION_HOURS=24
DISPUTE_ADMIN_REVIEW_HOURS=72

# Cloudflare R2 development bucket. Credentials stay on the backend only.
R2_ENABLED=true
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-dev-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-dev-secret-access-key
R2_BUCKET=commercehub-dev
MEDIA_PUBLIC_BASE_URL=https://images-dev.tienhoclaptrinh.site
R2_PRESIGN_DURATION_SECONDS=300
R2_MAX_IMAGE_SIZE_BYTES=2097152
R2_PRODUCT_IMAGE_WIDTH=1200
R2_PRODUCT_IMAGE_HEIGHT=900
R2_AVATAR_MAX_IMAGE_SIZE_BYTES=1048576
R2_AVATAR_IMAGE_WIDTH=512
R2_AVATAR_IMAGE_HEIGHT=512
R2_IMAGE_CACHE_CONTROL=public, max-age=31536000, immutable
R2_UPLOAD_COOLDOWN_SECONDS=3
R2_MAX_PRESIGNS_PER_15_MINUTES=20
R2_RATE_LIMIT_STORE=memory
R2_RATE_LIMIT_KEY_PREFIX=commercehub:r2:presign
# Required only when R2_RATE_LIMIT_STORE=redis.
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
CACHE_TYPE=none
CACHE_KEY_PREFIX=commercehub:local:cache
CACHE_DEFAULT_TTL=60s
CACHE_ACTIVE_CATEGORIES_TTL=15m
CACHE_BEST_SELLING_PRODUCTS_TTL=60s
CACHE_PUBLIC_PRODUCT_PAGES_TTL=60s
CACHE_PUBLIC_SHOPS_TTL=2m

# Realtime chat. PostgreSQL remains the source of truth; Redis only carries events.
CHAT_REDIS_PUBSUB_ENABLED=true
CHAT_REDIS_CHANNEL=commercehub:local:chat:events
CHAT_RATE_LIMIT_KEY_PREFIX=commercehub:local:chat:rate-limit
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_MAX_MESSAGES_PER_WINDOW=20
CHAT_RATE_LIMIT_WINDOW=10s
